# Copy to .env and adjust for your machine. .env is gitignored -- never
# commit real credentials (Ollama has none by default, but keep the habit).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini

# Bound to 0.0.0.0 regardless of this value -- see src/server.ts. Phones
# reach this over the LAN IP logged at startup, not localhost.
PORT=4001
